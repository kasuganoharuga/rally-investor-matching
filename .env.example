# Frontend public variables. Only expose values that are safe in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend application settings.
APP_NAME=Rally Investor Matching API
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Database URL for FastAPI when running outside Docker.
# Set locally in .env, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rally_investor_matching
DATABASE_URL=

# Local PostgreSQL settings used by docker-compose.yml.
# Leave POSTGRES_PASSWORD empty to use docker-compose defaults for local dev.
POSTGRES_DB=rally_investor_matching
POSTGRES_USER=rally
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# AI provider settings for the VC matching/RAG layer.
# Local development can use anthropic; AWS production can switch to bedrock.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
AWS_REGION=ap-southeast-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
