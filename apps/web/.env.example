# Next.js only loads env files from this directory (apps/web), not the repo
# root .env. Copy this file to apps/web/.env.local for local development.

# Frontend public variable. Only expose values that are safe in the browser.
# Base URL for non-matching API features. Matching goes through the authenticated
# Next.js server proxy; the browser never receives the matching secret.
NEXT_PUBLIC_MATCHING_API_BASE_URL=http://localhost:8000

# Server-only: must match the API's RALLY_MATCHING_API_SECRET. Never prefix
# with NEXT_PUBLIC_. AWS deployment generates a private random value.
RALLY_MATCHING_API_SECRET=rally-local-only-matching-key-change-for-deployment

# Postgres connection used by Better Auth and product repositories.
# Matches the docker-compose defaults in infra/docker/docker-compose.yml
# when the db service's 5432 port is published to the host.
DATABASE_URL=postgresql://rally:rally_dev_password@localhost:5432/rally_investor_matching

# Better Auth server secret (session/cookie signing). Generate a random
# 32+ character value for local development, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build absolute links/cookies.
BETTER_AUTH_URL=http://localhost:3000

# Canonical browser origin and email link destination.
APP_BASE_URL=http://localhost:3000

# Leave unset locally. The HTTPS EC2 deploy enables TRUST_PROXY=true only
# alongside loopback binding, behind nginx which replaces X-Real-IP.
# Without that invariant, registration uses a conservative shared IP limit.

# Additional local origin accepted by Better Auth when the app is opened
# through the numeric loopback address instead of localhost.
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Invitation and welcome email delivery. "console" logs the message and invite
# link (never a password) locally instead of sending real email.
# Not allowed when NODE_ENV=production.
EMAIL_PROVIDER=console

# Production uses EMAIL_PROVIDER=ses and the EC2 role/standard AWS credential chain.
# AWS_REGION=ap-southeast-2
# SES_FROM_EMAIL=Rally <verified-sender@example.com>
# SES_REPLY_TO_EMAIL=support@example.com
