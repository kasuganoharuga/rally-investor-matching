# Consumed by the FastAPI backend (apps/api) when run outside Docker, and by
# infra/docker/docker-compose.yml for local Postgres init values. Next.js
# (apps/web) does NOT read this file - it only loads env files from its own
# directory, so frontend/Better Auth settings live in apps/web/.env.example.

# Backend application settings.
APP_NAME=Rally Investor Matching API
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Database URL for FastAPI when running outside Docker. Matches the
# docker-compose defaults below (POSTGRES_* empty -> rally/rally_dev_password)
# so a plain `Copy-Item .env.example .env` works without edits. An empty
# value here is NOT safe: pydantic-settings treats a blank env var as an
# explicit override, so it would replace config.py's hardcoded default
# with "" and break the DB connection instead of falling back to it.
DATABASE_URL=postgresql://rally:rally_dev_password@localhost:5432/rally_investor_matching

# Local PostgreSQL settings used by infra/docker/docker-compose.yml.
# Leave POSTGRES_PASSWORD empty to use docker-compose defaults for local dev.
POSTGRES_DB=rally_investor_matching
POSTGRES_USER=rally
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# AI provider settings for the VC matching/RAG layer.
# Local development can use anthropic; AWS production can switch to bedrock.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
AWS_REGION=ap-southeast-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
