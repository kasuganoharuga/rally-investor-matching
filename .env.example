# Frontend public variables. Only expose values that are safe in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend application settings.
APP_NAME=Rally Investor Matching API
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://rally:rally_dev_password@localhost:5432/rally_investor_matching

# Local PostgreSQL settings used by docker-compose.yml.
POSTGRES_DB=rally_investor_matching
POSTGRES_USER=rally
POSTGRES_PASSWORD=rally_dev_password
POSTGRES_PORT=5432

# Future provider keys must stay in .env only and must never use NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=
