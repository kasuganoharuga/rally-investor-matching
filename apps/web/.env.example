# Next.js only loads env files from this directory (apps/web), not the repo
# root .env. Copy this file to apps/web/.env.local for local development.

# Frontend public variable. Only expose values that are safe in the browser.
# Base URL the browser uses to call the FastAPI matching/AI service directly.
NEXT_PUBLIC_MATCHING_API_BASE_URL=http://localhost:8000

# Postgres connection used by Better Auth and product repositories.
# Matches the docker-compose defaults in infra/docker/docker-compose.yml
# when the db service's 5432 port is published to the host.
DATABASE_URL=postgresql://rally:rally_dev_password@localhost:5432/rally_investor_matching

# Better Auth server secret (session/cookie signing). Generate a random
# 32+ character value for local development, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build absolute links/cookies.
BETTER_AUTH_URL=http://localhost:3000

# Additional local origin accepted by Better Auth when the app is opened
# through the numeric loopback address instead of localhost.
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Invitation email delivery. "console" logs the invite (including the
# temporary password) to the server console instead of sending real email.
# Not allowed when NODE_ENV=production.
EMAIL_PROVIDER=console
